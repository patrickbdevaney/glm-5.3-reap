[Unit]
Description=GLM-5.3-Flash REAP + heal pipeline (autonomous, resumable)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/patrickd/glm-5.3-reap
ExecStart=/home/patrickd/glm-5.3-reap/.venv/bin/python -u /home/patrickd/glm-5.3-reap/scripts/pipeline.py
# The pipeline is idempotent and resumable: always bring it back.
# Background stage children are detached (start_new_session) and own their own status.
# Default KillMode=control-group would kill them on every orchestrator restart.
KillMode=process
Restart=always
RestartSec=60
StandardOutput=append:/home/patrickd/glm-5.3-reap/logs/pipeline.log
StandardError=append:/home/patrickd/glm-5.3-reap/logs/pipeline.log
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_ENABLE_HF_TRANSFER=0
Environment=TOKENIZERS_PARALLELISM=false
# 135 differently-shaped batches fragment the caching allocator badly.
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# multi-day run; never let a stage be killed for taking too long
TimeoutStopSec=900

[Install]
WantedBy=default.target
