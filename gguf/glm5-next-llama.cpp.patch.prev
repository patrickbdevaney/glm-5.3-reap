index e9761a585..15783b5e5 100644
--- a/src/llama-arch.cpp
+++ b/src/llama-arch.cpp
@@ -245,6 +245,7 @@ static const std::map<llm_kv, const char *> LLM_KV_NAMES = {
     { LLM_KV_ATTENTION_HC_MULT,                      "%s.attention.hc.mult"                      },
